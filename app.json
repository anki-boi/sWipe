{
	"expo": {
		"name": "sWipe",
		"owner": "gomodtidy2",
		"slug": "swipe",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "swipe",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.gomodtidy.swipe"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/icon.png",
				"backgroundColor": "#ffffff"
			},
			"permissions": [
				"android.permission.READ_MEDIA_IMAGES",
				"android.permission.READ_MEDIA_VIDEO",
				"android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
			],
			"package": "com.gomodtidy.swipe",
			"blockedPermissions": [
				"android.permission.RECORD_AUDIO",
				"android.permission.SYSTEM_ALERT_WINDOW",
				"android.permission.READ_MEDIA_AUDIO",
				"android.permission.ACCESS_MEDIA_LOCATION",
				"android.permission.MANAGE_EXTERNAL_STORAGE",
				"android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
			]
		},
		"plugins": [
			[
				"expo-media-library",
				{
					"photosPermission": "Allow sWipe to access your photos and videos so you can review them.",
					"savePhotosPermission": "Allow sWipe to delete the photos and videos you choose.",
					"isAccessMediaLocationEnabled": false
				}
			],
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash.png",
					"resizeMode": "cover",
					"backgroundColor": "#ffffff",
					"enableFullScreenImage_legacy": true
				}
			],
			[
				"expo-font",
				{
					"fonts": [
						"./assets/fonts/Rubik-Bold.ttf",
						"./assets/fonts/Rubik-ExtraBold.ttf",
						"./assets/fonts/Rubik-Light.ttf",
						"./assets/fonts/Rubik-Medium.ttf",
						"./assets/fonts/Rubik-Regular.ttf",
						"./assets/fonts/Rubik-SemiBold.ttf"
					]
				}
			],
			[
				"expo-video",
				{
					"supportsBackgroundPlayback": false,
					"supportsPictureInPicture": false
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {
				"origin": false
			},
			"eas": {
				"projectId": "e109229a-a158-4218-9dd8-c6703215f3ee"
			}
		}
	}
}
